{
  "_comment": "Example site config for flythrough/. Copy it beside your model (project data stays out of this repo) and change the labels to match your FreeCAD groups.",
  "frame": "<App::Part label that carries the layout frame>",
  "origin": {
    "outline": "<label of a closed wire: fence or compound line>"
  },
  "ground": {
    "terrain": [
      "<Mesh::Feature label (TIN)>"
    ],
    "aerial": "<Image::ImagePlane label>",
    "grid": 240,
    "pad": {
      "outline": "<same closed wire as origin, or the pad edge>",
      "margin_m": 8,
      "cut_m": 0.05,
      "hardstand": true,
      "color": [
        0.46,
        0.45,
        0.42
      ]
    }
  },
  "show_groups": [
    "_10_3D_Model",
    "_05_Site_Works_3D"
  ],
  "exclude_paths": [
    "_00_Components"
  ],
  "drop_flat_below_m": 0.002,
  "collections": [
    {
      "name": "groundworks",
      "label_regex": "^(Hall_FloorSlab|Office_L1_Slab|Truck_Apron|Site_Driveway|Loading_Dock_Platform|CarPark_(Pavement|Footpath|Entry_Strip))$"
    },
    {
      "name": "hall_roof",
      "paths": [
        "_11a_Hall_Roof"
      ]
    },
    {
      "name": "hall_frame",
      "label_regex": "^Hall_Portal_Columns$"
    },
    {
      "name": "hall",
      "paths": [
        "_11_Data_Hall_3D"
      ]
    },
    {
      "name": "office_roof",
      "paths": [
        "_13c_Office_Roof"
      ]
    },
    {
      "name": "office_L2",
      "paths": [
        "_13b_Office_L2"
      ]
    },
    {
      "name": "office_L1",
      "paths": [
        "_13a_Office_L1"
      ]
    },
    {
      "name": "pods",
      "paths": [
        "_15_AI_Pods_3D"
      ]
    },
    {
      "name": "mv_pods",
      "label_regex": "^MVPOD_"
    },
    {
      "name": "ptus",
      "label_regex": "^(IT|MECH)_PTU"
    },
    {
      "name": "gensets",
      "label_regex": "^GENSET_"
    },
    {
      "name": "chillers",
      "label_regex": "^(HTCH|CH)-"
    },
    {
      "name": "carpark",
      "paths": [
        "_14_Car_Park_3D"
      ]
    },
    {
      "name": "fence",
      "paths": [
        "_05_Site_Works_3D"
      ]
    }
  ],
  "default_collection": "other",
  "materials": [
    {
      "match": "Glazing",
      "color": [
        0.55,
        0.72,
        0.85
      ],
      "alpha": 0.3,
      "roughness": 0.05
    },
    {
      "match": "ChainMesh",
      "color": [
        0.55,
        0.57,
        0.6
      ],
      "alpha": 0.35,
      "roughness": 0.5,
      "metallic": 0.6
    },
    {
      "match": "Accessible_Bays",
      "color": [
        0.15,
        0.35,
        0.8
      ]
    },
    {
      "match": "Bay_Lines",
      "color": [
        0.95,
        0.95,
        0.9
      ],
      "roughness": 0.8
    },
    {
      "match": "Vehicle_Gate",
      "color": [
        0.9,
        0.55,
        0.1
      ],
      "metallic": 0.3
    },
    {
      "match": "_Stack$",
      "color": [
        0.15,
        0.15,
        0.15
      ],
      "metallic": 0.5
    },
    {
      "match": "Hall_(Wall|Roof)_Cladding",
      "color": [
        0.82,
        0.84,
        0.86
      ],
      "metallic": 0.4,
      "roughness": 0.35
    },
    {
      "match": "Pavement|Driveway|Apron|Entry_Strip",
      "color": [
        0.2,
        0.2,
        0.21
      ],
      "roughness": 0.9
    }
  ],
