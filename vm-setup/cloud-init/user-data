#cloud-config
users:
  - name: freecad
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: freecad123
    ssh_authorized_keys: []

package_update: true
package_upgrade: true

packages:
  - openssh-server
  - curl
  - git
  - python3-pip
  - python3-venv
  - xvfb
  - net-tools
  - software-properties-common

runcmd:
  - systemctl enable ssh
  - systemctl start ssh
  - echo "Cloud-init provisioning complete" > /var/log/cloud-init-done

final_message: "Cloud-init complete. System ready for FreeCAD provisioning."
