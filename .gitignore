# OS / editor
.DS_Store

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# FreeCAD
*.FCBak

# gstack
.gstack/

# ── Data stores and caches ────────────────────────────────────────────────
# Working state, not source. Regenerated by the tools that own them.
*.sqlite
*.sqlite-journal
*.sqlite-wal
dc-model/ingest-state.json
dc-model/collector-frontier.sqlite

# ── Generated artefacts ───────────────────────────────────────────────────
# Reports and schedules are build output; the builder script is the source.
# Keep any figure a write-up references by un-ignoring it explicitly.
dc-model/status/status-*.html
dc-model/out/
cable-sizing/out/

# ── Corpus and third-party documents ──────────────────────────────────────
# Vendor datasheets, vendor CAD and planning-portal drawings are third-party
# copyright. They are collected for internal engineering use and must not be
# redistributed from a public repo. See PUBLISH-REVIEW.md.
dc-model/sources/**/*.pdf
dc-model/eval/**/img/
dc-model/derived/
**/datasheets/*.pdf

# Vendor documents and CAD. Collected to the private artifacts bucket for
# internal engineering use; not ours to redistribute. See catalogue/sources.yaml.
cable-tray-ezystrut/datasheets/*.pdf
cable-tray-ezystrut/models/step-files/
catalogue/.frontier.sqlite

# Generated media and reports. Rebuild with make_*.py and build_report_*.py;
# the source data is in S3 (see cfd-cabinet-cooling/README.md).
cfd-cabinet-cooling/**/*.mp4
cfd-cabinet-cooling/**/report-*.html
cfd-cabinet-cooling/**/web/

# Standards tables transcribed from licensed copies. Code that reads them is
# open source; the tables are not ours to publish. In S3 under standards/.
cable-sizing/as3008_impedance_tables.json
cable-sizing/as3008_vc_tables.json
cable-sizing/as3008_short_circuit.json
catalogue/.frontier.sqlite
catalogue/data/
cable-sizing/as3008_ratings.json

# AS/NZS 3000:2018 table bodies. Split from reference_tables.json by B5: the
# provenance, clause numbers, units and the clause 3.6.2 limits (5/7/11 %) stay
# public in reference_tables_public.json, which IS tracked. Everything that
# reproduces a table body -- Table 3.2, Table 3.3, Table 3.4, Table 5.1,
# C8, C10-C12 and clause 5.3.2.1.2 -- lives here and in S3 under
# standards/as-nzs-3000/.
cable-sizing/reference_tables.json

# Rating and factor tables for the dame_cable package, transcribed from the
# licensed AS/NZS copies. Same posture as the JSON tables above: the code is
# open source, the numbers are not. Synthetic stand-ins live in
# cable-sizing/tests/fixtures/ and ARE tracked.
cable-sizing/data/*.csv
!cable-sizing/data/.gitkeep

# Third-party manufacturer catalogues. Same posture as the standards tables:
# the code that reads them is open source, the data is not ours to redistribute.
# In S3 under vendor/. Fetch with tools/data_pull_vendor.sh.
cables/cable_catalog.json

# Nexans product documentation. Twenty files, ~1,300 tabulated data rows, every
# one declaring a Nexans source or "Manufacturer: Nexans Australia (Olex)" and
# then reproducing OD, weight, bend radius, pull tension and ratings per size.
# Same data as cable_catalog.json in prose form; withholding the JSON while
# publishing these would not be a coherent position. In S3 under
# vendor/nexans/docs/. README.md and AGENT_INSTRUCTIONS.md are OURS and stay.
cables/*.md
!cables/README.md
!cables/AGENT_INSTRUCTIONS.md
cable-tray-ezystrut/tray_catalogue.json
cable-sizing/tricab_families.json

# Ezystrut reference library. These two REPRODUCE vendor material: both declare
# an Ezystrut source and carry 37 and 47 rows of transcribed dimensions between
# them, so they travel with tray_catalogue.json rather than being published
# while the JSON is withheld.
#
# JOINING_RULES.md is deliberately NOT here. It DISCUSSES the products in our
# own words -- no declared source, zero part numbers, our own section scheme,
# and its one dimensional rule cites AS/NZS 3000 cl. 3.9.5 rather than a vendor
# guide. Making our own engineering writing private because it names real
# products would leave the public repo unable to say anything about anything.
cable-tray-ezystrut/INDEX.md
cable-tray-ezystrut/GUIDELINES.md
cable-tray-ezystrut/reference/*.png

# Ezystrut markdown transcriptions. INDEX.md is a reference library built from
# their datasheets; GUIDELINES.md carries their product depths and load/span
# tables. Korvest terms prohibit reposting. In S3 under vendor/ezystrut/.
# JOINING_RULES.md and VERIFICATION_REPORT.md stay — those are our engineering.
cable-tray-ezystrut/INDEX.md
cable-tray-ezystrut/GUIDELINES.md

# Spec-exchange working files that carry transcribed table values. The ASK and
# ANS documents themselves are tracked and publishable; anything needing real
# numbers to make its point lives here instead.
spec-exchange/private/

# Claude Code session state. Local scheduling and task bookkeeping, not source.
# Was in .git/info/exclude, which Step 6's fresh init discarded — so it is here
# now, where a re-init cannot lose it again.
.claude/

# Third-party calculator captures. B7 in PUBLISH-REVIEW.md: the same category as
# the Ezystrut screenshots in B6, in a directory B6 never scanned. The ELEK pages
# carry "© 2026 ELEK® Software. All Rights Reserved." verbatim, tricab-cable-calc.js
# is Tricab's own source, and elek-calculator.png is a screenshot of their UI.
#
# Nothing opens these at runtime — every reference in standards.py,
# cable_sizing.py and test_cable_sizing.py is a provenance comment — so unlike
# B5 this does not break a clean checkout. compare_elek.py, compare_au_nz.py and
# build_tricab_families.py are OURS and stay. In S3 under vendor/calculators/.
cable-sizing/reference/elek-*.txt
cable-sizing/reference/elek-calculator.png
cable-sizing/reference/jcalc-*.txt
cable-sizing/reference/tricab-cable-calc.js
