# AU01 whitespace CFD - solver-side parameters only.
#
# GEOMETRY IS NOT SET HERE. Every dimension comes from the FreeCAD export:
#   system/cfd_export_params.json      (planes, extents, rack schedule)
#   constant/triSurface/*.stl          (the actual surfaces snappyHexMesh uses)
# Both are copied verbatim from DAME_AU01_CFD_SingleRoom Rev E, archived in
# ../geometry/CFD_Export_RevE. To change the room, re-export and re-copy.

# --- mesh ---------------------------------------------------------------
cellSize            0.10      # base cell; the export states 50 mm and drops
                              # sub-50 mm clutter on that basis
thinPlateLevel      2         # refinement on 80-100 mm plates (bulkheads, HAC
                              # baffles/doors) and gantry members; at level 0 a
                              # 2-cell-thick plate does not close reliably

# --- duty (Rev E export README / FWCV brochure) -------------------------
modulesPerEnd       2         # 40L2 = 2 stacked 40L1 modules
unitAirflow_m3h     130000    # PER END (both modules)
unitCapacity_kW     475       # PER END
supplyTemp_C        28.0
serverDeltaT_K      15.0

# --- scenario -----------------------------------------------------------
bulkhead            h4000     # RAISED. With h3000 the return slot sat on the same
                              # plane as the discharge and ~1 m from it, pulling
                              # 4.79 m/s against the supply's 2.26 m/s: 78 % of
                              # the supply short-circuited and only 22 % reached
                              # the racks. h4000 puts the slot above the unit top.
gantry              1         # 1 = include the overhead structure

# The three service-run cross-heads are exported with their underside at 1.810 m,
# 190 mm BELOW the 2.0 m rack tops and ~250 mm in front of the intake faces. The
# three racks they cross (01, 06/07, 12) carry the three hottest faces in the
# hall. Treat that as a CAD bug: this lifts them clear so the fix can be tested,
# and the model needs the same correction.
intakeBands         4         # height bands per rack intake face
crossHeadClearance  0         # the heads are gone from the CAD now, nothing to raise

# --- return plenum (NOT in the Rev E CAD export - generated by the script) ---
# The short-circuit fix. A deck over the cold side, open only above the hot
# aisle, so supply cannot reach the return without passing through a rack.
# Its top must sit at the fan wall top (4.0 m): any lower and the upper part of
# the discharge blows straight into the plenum and short-circuits again.
plenumFloorZ        4.0       # 0 = no plenum
plenumDeckThickness 0.05
sealPodEnds         1         # close the baffled channel ends up to the deck

# Throttle. With a capped cold side the surplus has nowhere to go: the fan walls
# move 84.65 kg/s and the racks draw 48.8. 0.60 gives a ~10 % surplus, which
# keeps the cold side positive against the hot aisle without re-opening the
# short circuit. Nameplate (1.0) is kept as the A/B.
supplyThrottle      0.60
unitsOff            none      # none, or space separated: W1 W2 E1 E2

# --- ASHRAE envelope (A2, Supermicro SYS-422GS-NB3RT-ALC) ---------------
allowableMax_C      35.0
recommendedMax_C    27.0

# --- solver -------------------------------------------------------------
# buoyantSimpleFoam (steady) cannot converge this geometry: the open-top hot
# aisle makes the flow buoyancy driven and genuinely unsteady. A 4000 iteration
# steady run on 19 Aug 2026 closed its energy balance to 103 % yet was still
# marching the intake temperatures up at +1.73 K per 1000 iterations with no
# plateau. Use the transient solver and time average.
solver              buoyantPimpleFoam
endTime             30.0      # it peaks at ~7 s and is settling by 14 s; 60 s was overkill
averageFrom         18.0      # 12 s of averaging, well past the overshoot
maxCo               3.0
maxDeltaT           0.05
writeEvery          15.0      # seconds between field writes

# --- run ----------------------------------------------------------------
iterations          4000     # steady only, ignored when solver is transient
writeInterval       500
functionInterval    10        # metrics every N iters so the plotter can
                              # window-average the peak (per MODEL-REVIEW)
numberOfSubdomains  8
fanStiffness        200      # was 50, which let the rack fans undershoot
                             # their target by ~20 % against the pressure field
reconstruct         1        # need fields for slices and renders
