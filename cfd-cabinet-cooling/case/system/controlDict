/*--------------------------------*- C++ -*----------------------------------*\
| Steady buoyant RANS.  The function objects at the bottom ARE the            |
| deliverable: they are what decides sufficient / insufficient cooling.       |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     buoyantSimpleFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         3000;           // iteration cap; residualControl usually stops earlier

deltaT          1;

writeControl    timeStep;
writeInterval   500;
purgeWrite      2;

writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

functions
{
    // ---- THE pass/fail number: mean air temperature entering the servers --
    cabinetInletT
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      faceZone;
        name            cabinetInlet;
        operation       areaAverage;
        fields          (T);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   10;
        log             false;
    }

    // ---- worst-case server intake temperature (top-of-rack hot spot) ------
    cabinetInletTmax
    {
        $cabinetInletT;
        operation       max;
    }

    // ---- sanity check: exhaust should sit ~15 K above intake --------------
    cabinetOutletT
    {
        $cabinetInletT;
        name            cabinetOutlet;
    }

    // ---- calibration check: through-cabinet mass flow [kg/s] --------------
    cabinetFlow
    {
        $cabinetInletT;
        operation       sum;
        fields          (phi);
    }

    // ---- bypass (+) vs recirculation (-) over the containment [kg/s] ------
    containmentGapFlow
    {
        $cabinetFlow;
        name            containmentGap;
    }

    // ---- supply delivered by the fan wall [kg/s] (negative = inflow) ------
    fanWallFlow
    {
        $cabinetFlow;
        regionType      patch;
        name            fanWall;
    }

    // ---- returned to the intake on top of the unit [kg/s] ----------------
    // Must equal the supply: the fan wall is a closed loop through the hall.
    intakeFlow
    {
        $cabinetFlow;
        regionType      patch;
        name            fanWallIntake;
    }

    // ---- temperature of the air coming back to the unit ------------------
    intakeT
    {
        $cabinetInletT;
        regionType      patch;
        name            fanWallIntake;
    }

    // ---- convergence / divergence watch ----------------------------------
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p_rgh h k omega);
        writeControl    timeStep;
        writeInterval   1;
    }

    Tlimits
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (T U);
        writeControl    timeStep;
        writeInterval   10;
        log             false;
    }

    // ---- per-cabinet metrics (generated by make_row_dicts.py) -------------
    #include "rowFunctions"

    // ---- temperature in degrees C, written for ParaView -------------------
    TdegC
    {
        type            expressions;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        expressions
        (
            {
                name        TdegC;
                dimensions  [0 0 0 1 0 0 0];
                expression  "T - 273.15";
            }
        );
    }
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
